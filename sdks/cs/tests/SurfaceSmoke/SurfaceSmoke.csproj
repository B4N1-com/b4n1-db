<Project Sdk="Microsoft.NET.Sdk">

  <!-- Smoke runner for the SDK surface: one console program that exercises all
       nine engines against the real binary. It lives in its own project because
       the SDK project globs **/*.cs — a Main() next to it would be packaged
       into the netstandard library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SurfaceSmoke</AssemblyName>
    <RootNamespace>SurfaceSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../B4N1.Db.csproj" />
  </ItemGroup>

</Project>
